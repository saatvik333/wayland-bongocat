# Bongo Cat configuration
#
# Save as ~/.config/bongocat/bongocat.conf and run `bongocat --watch-config`.
# Every setting is optional; the values below are the defaults.
# Check this file with `bongocat --check-config`.

# --- Cat ----------------------------------------------------------------------

# Height in pixels, 10-200.
cat_height=40
# left, center or right; the offsets move the cat from there. y is measured
# from the bar's vertical center.
cat_align=center
cat_x_offset=100
cat_y_offset=10
# Flip horizontally or vertically.
mirror_x=0
mirror_y=0

# --- Bar ----------------------------------------------------------------------

# Height in pixels, 20-300.
overlay_height=50
# Background opacity, 0 (transparent) to 255.
overlay_opacity=150
# top or bottom.
overlay_position=top
# background, bottom, top or overlay. overlay stays above fullscreen windows.
layer=top
# 1 keeps the cat visible over fullscreen windows on its monitor.
disable_fullscreen_hide=0

# --- Monitors -----------------------------------------------------------------

# Without monitor=, one cat follows the focused monitor; 0 keeps it on the
# first monitor instead.
follow_active_monitor=1
# Comma-separated monitors to show a cat on. See `bongocat --list-monitors`.
# monitor=eDP-1,HDMI-A-1

# --- Keyboards ----------------------------------------------------------------

# Every keyboard is read unless devices are selected below. Both settings can
# be repeated. `bongocat --list-devices` prints lines to paste.
# keyboard_device=/dev/input/by-id/usb-Vendor_Keyboard-event-kbd
# keyboard_name=AT Translated Set 2 keyboard

# --- Animation ----------------------------------------------------------------

# Maximum frame changes per second, 1-120.
fps=60
# Milliseconds a paw stays down after a key press, 10-5000.
keypress_duration=100
# 1: keys on the left half of the keyboard play the left paw.
# 0: each key press plays a random paw.
enable_hand_mapping=1
# Frame shown while idle: 0 both paws up, 1 left down, 2 right down,
# 3 both down, 4 sleeping.
idle_frame=0
# Tap a random paw every N seconds without input (0 disables), holding it for
# test_animation_duration milliseconds.
test_animation_interval=0
test_animation_duration=200

# --- Sleep --------------------------------------------------------------------

# Show the sleeping cat after N seconds without input, 0-3600 (0 disables).
idle_sleep_timeout=0
# Sleep daily from sleep_begin to sleep_end (HH:MM, may cross midnight; both
# default to 00:00). Key presses are ignored while asleep.
enable_scheduled_sleep=0
# sleep_begin=22:00
# sleep_end=06:00

# --- Debug --------------------------------------------------------------------

# Log runtime activity. Key presses are never logged.
enable_debug=0

# --- Per-monitor appearance ---------------------------------------------------

# Sections override the Cat and Bar settings above for one monitor; they do
# not select monitors. [global] returns to global settings.
# [monitor:HDMI-A-1]
# cat_height=60
# cat_align=right
# mirror_x=1
# [global]
